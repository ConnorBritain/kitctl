{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ConnorBritain/kitctl/blob/main/docs/report.schema.json",
  "title": "kitctl inventory report",
  "description": "Schema version 2. Reports carry paths, hashes, safe metadata, and findings; never configuration values.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "hash_scheme", "adapters", "roots", "entries", "findings"],
  "properties": {
    "schema_version": {"const": 2},
    "generated_by": {"type": "string", "pattern": "^kitctl "},
    "hash_scheme": {"const": 2},
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": {"$ref": "#/$defs/adapter"},
        "codex": {"$ref": "#/$defs/adapter"}
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repos", "claude_config_dir", "codex_home"],
      "properties": {
        "mode": {"enum": ["explicit", "config", "cwd"]},
        "repos": {"type": "array", "items": {"type": "string"}},
        "claude_config_dir": {"type": "string"},
        "codex_home": {"type": "string"}
      }
    },
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}}
  },
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified_versions"],
      "properties": {"verified_versions": {"type": "array", "items": {"type": "string"}}}
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "harness", "scope", "name", "path", "content_hash", "hash_scheme",
        "link_target", "target_in_scan", "provided_by", "repo", "metadata"
      ],
      "properties": {
        "kind": {
          "enum": [
            "skill", "agent", "command", "mcp_server", "plugin", "marketplace", "hook",
            "instructions", "settings", "rules", "link"
          ]
        },
        "harness": {"enum": ["claude", "codex", "shared"]},
        "scope": {"enum": ["managed", "user", "project", "local", "plugin"]},
        "name": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "hash_scheme": {"enum": [2, null]},
        "link_target": {"type": ["string", "null"]},
        "target_in_scan": {"type": ["boolean", "null"]},
        "provided_by": {"type": ["string", "null"]},
        "repo": {"type": ["string", "null"]},
        "metadata": {"type": "object"}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": {"enum": ["info", "warning", "error"]},
        "code": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "path": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
