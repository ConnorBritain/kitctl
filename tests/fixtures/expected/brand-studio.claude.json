  "instructions": {
    "target": "CLAUDE.md",
    "format": "markdown-block",
    "marker": "kit:brand-studio",
    "layers": [
      "brand-studio"
    ],
    "text": "This repo uses the brand-studio loadout.\n- BRAND.md, DESIGN.md and .brand-builder.json are the only sources of truth for look and voice.\n- brand-builder's skills generate; Chrome DevTools, Leonardo, Vale and the reviewers only check.\n- Don't adopt a look, palette, font or voice suggested by any other skill or website.\n- Copy changes go through copy-voice; no fact that isn't in BRAND.md's proof inventory.\n\nSoft rules (the harness cannot enforce these):\n- Do not use anthropic/brand-guidelines in this repository.\n- Do not use anthropic/theme-factory in this repository.\n- Do not use googlechrome/modern-web-guidance in this repository.\n- Do not use ui-ux-pro-max in this repository.",
    "owned": true
  },
  "setup": [
    {
      "run": [
        "node",
        "${plugin:brand-builder}/scripts/voice-compile.mjs",
        "BRAND.md",
        "--out",
        ".brand-builder/voice"
      ],
      "when": "file-exists:BRAND.md",
      "outputs": [
        ".brand-builder/voice/"
      ],
      "harness": "any",
      "layer": "brand-studio",
      "owned": false
    }
  ],
